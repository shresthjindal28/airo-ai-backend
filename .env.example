DATABASE_URL=postgresql://user:password@localhost:5432/airo

WORKER_ENABLED=true
WORKER_CONCURRENCY=4
POLL_INTERVAL_SECONDS=2
JOB_TIMEOUT_SECONDS=300
MAX_JOB_ATTEMPTS=3

LOG_LEVEL=INFO

APP_NAME=airo-ai
DEBUG=false

REDIS_URL=redis://localhost:6379/0
TRANSCRIPT_EVENTS_CHANNEL=airo:transcript:events

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=airo-storage
R2_ENDPOINT_URL=https://your-cloudflare-account-id.r2.cloudflarestorage.com

STT_PROVIDER=sarvam
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_MODEL=saaras:v3
# translate = always output English; transcribe = keep spoken language
SARVAM_MODE=translate

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Required for AI SOAP note generation (Inference API)
# HF_TOKEN=hf_your_huggingface_token
# Use "auto" to route via Groq/Together/etc. — "hf-inference" only supports small/legacy models.
SOAP_LLM_PROVIDER=auto
SOAP_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
SOAP_LLM_MAX_TOKENS=1200

PRESCRIPTION_PROVIDER=huggingface
PRESCRIPTION_LLM_PROVIDER=auto
PRESCRIPTION_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
PRESCRIPTION_LLM_MAX_TOKENS=2000

# Required when EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-key
